# ==============================================================================
# WORKZEN ENTERPRISE SaaS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Tagline: "Plan Smarter. Work Together. Achieve More."
# Copy this file to .env and configure your local environment settings.
# NEVER commit private API keys, secrets, or database credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:3070
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. PUBLIC FRONTEND CLIENT CONFIGURATION (Vite 'VITE_' prefix required)
# ------------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER place secret tokens or private keys in VITE_ variables!
VITE_APP_NAME=WORKZEN
VITE_APP_TAGLINE="Plan Smarter. Work Together. Achieve More."
VITE_API_URL=http://localhost:5050/api/v1
VITE_SOCKET_URL=http://localhost:5050

# ------------------------------------------------------------------------------
# 3. DATABASE PERSISTENCE (MongoDB & Mongoose)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/workzen_dev
MONGODB_TEST_URI=mongodb://localhost:27017/workzen_test

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY TOKENS (JWT)
# ------------------------------------------------------------------------------
# Cryptographically random strings (min 32 characters in production)
JWT_ACCESS_SECRET=workzen_dev_access_secret_key_32_characters_long_min
JWT_REFRESH_SECRET=workzen_dev_refresh_secret_key_32_characters_long_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION SERVICE (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_smtp_user
SMTP_PASSWORD=dummy_smtp_password
EMAIL_FROM="WORKZEN Notifications <notifications@workzen.io>"

# ------------------------------------------------------------------------------
# 6. CLOUD FILE STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=workzen_dev_cloud
CLOUDINARY_API_KEY=dummy_cloudinary_key
CLOUDINARY_API_SECRET=dummy_cloudinary_secret

# ------------------------------------------------------------------------------
# 7. PAYMENT & SUBSCRIPTION GATEWAYS (Stripe & Paystack)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

PAYSTACK_SECRET_KEY=sk_test_placeholder_key
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY THROTTLING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
